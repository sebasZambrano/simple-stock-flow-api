<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>SimpleStockFlow.Adapters.Rest</RootNamespace>
    <AssemblyName>SimpleStockFlow.Adapters.Rest</AssemblyName>
    <!--
      Overrides the solution-wide default. Swagger reads its operation descriptions from this
      file and from nowhere else: without it the page lists routes and status codes and says
      nothing about what any of them mean, which is not "readable documentation of the API".
      Everything public here is documented, so CS1591 stays an error like every other warning.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../../application/SimpleStockFlow.Application.csproj" />
  </ItemGroup>
</Project>
